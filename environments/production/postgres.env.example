# ╔═══════════════════════════════════════════════════════════╗
# ║  PostgreSQL Platform — Environment Configuration          ║
# ║  Copy this file to postgres.env and fill in real values   ║
# ╚═══════════════════════════════════════════════════════════╝

# --- PostgreSQL Superuser ---
POSTGRES_USER=itsmeh_admin
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# --- Replication (for future streaming replica) ---
# POSTGRES_REPLICATION_USER=replicator
# POSTGRES_REPLICATION_PASSWORD=<CHANGE_ME>

# --- Prometheus Exporter (uncomment when enabling exporter) ---
# PG_EXPORTER_DSN=postgresql://postgres_exporter:<CHANGE_ME>@postgres:5432/postgres?sslmode=disable

# --- Day-One Seed Services ---
# List of databases to seed in format: "role_name:db_name:PASSWORD_ENV_VAR_NAME"
# Space-separated if multiple.
SEED_DATABASES="core_api:itsmeh_core:CORE_API_DB_PASSWORD keycloak:keycloak:KEYCLOAK_DB_PASSWORD"

CORE_API_DB_PASSWORD=<CHANGE_ME_CORE_PW>
KEYCLOAK_DB_PASSWORD=<CHANGE_ME_KC_PW>
