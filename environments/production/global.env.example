APP_ENV=production
DOMAIN=example.com
API_DOMAIN=api.example.com
# your platform services will be under this subdomain i.e. pgadmin.<platform_subdomain>.<domain>
PLATFORM_SUBDOMAIN=darbar
TZ=Asia/Kolkata

# --- Nginx Host Port Bindings ---
# Default is 80 and 443 (all interfaces).
# If INGRESS_MODE=cloudflare_tunnel, you can bind to loopback (127.0.0.1:80)
# so the host does not expose Nginx ports to the public internet.
# NGINX_PORT_HTTP=80
# NGINX_PORT_HTTPS=443