# ╔═══════════════════════════════════════════════════════════╗
# ║  pgAdmin 4 — Environment Configuration                    ║
# ║  Copy this file to pgadmin.env and fill in real values    ║
# ╚═══════════════════════════════════════════════════════════╝

# --- pgAdmin Login Credentials ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=<CHANGE_ME_STRONG_PASSWORD>

# --- Disable built-in Postfix (no outbound email) ---
PGADMIN_DISABLE_POSTFIX=true

# --- Security Hardening ---
PGADMIN_CONFIG_ENHANCED_COOKIE_PROTECTION=True
PGADMIN_CONFIG_LOGIN_BANNER="'Authorized personnel only. All activity is logged.'"
PGADMIN_CONFIG_CONSOLE_LOG_LEVEL=10

# --- Auto-register PostgreSQL server ---
# These are used by the entrypoint wrapper to generate servers.json dynamically.
# POSTGRES_USER is read from postgres.env (shared via env_file in docker-compose).
PGADMIN_SERVER_NAME=ItsMeh PostgreSQL
PGADMIN_SERVER_HOST=postgres
PGADMIN_SERVER_PORT=5432
