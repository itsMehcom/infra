# ╔═══════════════════════════════════════════════════════════╗
# ║  Cloudflare Tunnel — Environment Configuration            ║
# ║  Copy this file to cloudflared.env and fill in real values║
# ╚═══════════════════════════════════════════════════════════╝

# --- Tunnel Token ---
# Obtain from: Cloudflare Dashboard → Zero Trust → Networks → Tunnels
# Create a tunnel, then copy the token from the "Install and run a connector" step.
# This token authenticates the connector to Cloudflare and determines which
# ingress rules apply (configured in the Cloudflare dashboard, NOT locally).
TUNNEL_TOKEN=<PASTE_YOUR_TUNNEL_TOKEN_HERE>
